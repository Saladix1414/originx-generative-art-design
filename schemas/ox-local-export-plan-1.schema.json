{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ox-local-export-plan-1.schema.json",
  "title": "OriginX Generative Art Design Local Export Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "phase",
    "export_id",
    "release_id",
    "canonical_id",
    "status",
    "planned_paths"
  ],
  "properties": {
    "schema_version": { "const": "ox-local-export-plan-1" },
    "project": { "const": "originx-generative-art-design" },
    "phase": { "const": "phase16" },
    "export_id": { "type": "string", "minLength": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "canonical_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planned", "blocked"] },
    "planned_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "artifact_path"],
      "properties": {
        "manifest_path": {
          "type": "string",
          "pattern": "^output/canonical/[A-Za-z0-9._-]+/manifest.json$"
        },
        "artifact_path": {
          "type": "string",
          "pattern": "^output/canonical/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        }
      }
    }
  }
}
