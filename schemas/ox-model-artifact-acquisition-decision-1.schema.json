{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ox-model-artifact-acquisition-decision-1.schema.json",
  "title": "OriginX Model Artifact Acquisition Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionVersion",
    "decision",
    "reasonCodes",
    "source",
    "governance",
    "modelArtifactAcquisitionDecisionHash"
  ],
  "properties": {
    "decisionVersion": {
      "const": "OX-MODEL-ARTIFACT-ACQUISITION-DECISION-1"
    },
    "decision": {
      "const": "BLOCKED_NO_ARTIFACT"
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MODEL_ARTIFACT_MISSING",
          "DOWNLOAD_NOT_AUTHORIZED",
          "INSTALLATION_NOT_AUTHORIZED",
          "TRUST_NOT_GRANTED",
          "EXECUTION_NOT_AUTHORIZED"
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "artifactEvidenceHash",
        "artifactEvidenceState"
      ],
      "properties": {
        "modelId": { "type": "string", "minLength": 3 },
        "artifactEvidenceHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifactEvidenceState": { "const": "MISSING" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downloadAllowed",
        "installationAllowed",
        "trustGranted",
        "executionAllowed",
        "mediaGenerationAllowed",
        "decisionGrantsAcquisitionAuthority",
        "decisionGrantsExecutionAuthority"
      ],
      "properties": {
        "downloadAllowed": { "const": false },
        "installationAllowed": { "const": false },
        "trustGranted": { "const": false },
        "executionAllowed": { "const": false },
        "mediaGenerationAllowed": { "const": false },
        "decisionGrantsAcquisitionAuthority": { "const": false },
        "decisionGrantsExecutionAuthority": { "const": false }
      }
    },
    "modelArtifactAcquisitionDecisionHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
