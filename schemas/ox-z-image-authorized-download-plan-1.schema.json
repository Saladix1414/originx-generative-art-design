    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downloadAllowed",
        "installationAllowed",
        "executionAllowed",
        "canonicalizationAllowed"
      ],
      "properties": {
        "downloadAllowed": {
          "const": false
        },
        "installationAllowed": {
          "const": false
        },
        "executionAllowed": {
          "const": false
        },
        "canonicalizationAllowed": {
          "const": false
        }
      }
