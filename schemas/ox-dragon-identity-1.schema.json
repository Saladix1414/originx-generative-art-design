{
  "$id": "https://originx.local/schemas/ox-dragon-identity-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "akashic": {
      "additionalProperties": false,
      "properties": {
        "akashicVersion": {
          "type": "string"
        },
        "appendOnly": {
          "type": "boolean"
        },
        "bindingStatus": {
          "const": "CANONICAL_BOUND"
        },
        "events": {
          "type": "array"
        },
        "headHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "tamperEvident": {
          "type": "boolean"
        },
        "tokenId": {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "bindingStatus",
        "akashicVersion",
        "tokenId",
        "appendOnly",
        "tamperEvident",
        "events",
        "headHash"
      ],
      "type": "object"
    },
    "anatomy": {
      "additionalProperties": true,
      "required": [
        "bodyStructure",
        "headStyle",
        "hornStyle",
        "eyeType",
        "wingStyle",
        "tailStyle",
        "limbStyle",
        "silhouetteProfile"
      ],
      "type": "object"
    },
    "armorAndRelics": {
      "additionalProperties": true,
      "required": [
        "hasArmor",
        "hasWeapon",
        "hasEmbeddedRelic"
      ],
      "type": "object"
    },
    "classification": {
      "additionalProperties": true,
      "required": [
        "archetype",
        "temperament",
        "presence",
        "combatRole",
        "domain"
      ],
      "type": "object"
    },
    "composition": {
      "additionalProperties": true,
      "required": [
        "cameraAngle",
        "framing",
        "pose",
        "silhouettePriority",
        "storyBeat"
      ],
      "type": "object"
    },
    "detailPolicy": {
      "required": [
        "macroPriority",
        "mesoPriority",
        "microPriority"
      ],
      "type": "object"
    },
    "environment": {
      "additionalProperties": true,
      "required": [
        "setting",
        "architecture",
        "weather",
        "atmosphere",
        "scale"
      ],
      "type": "object"
    },
    "glyph": {
      "additionalProperties": false,
      "properties": {
        "bindingStatus": {
          "const": "CANONICAL_BOUND"
        },
        "geometry": {},
        "glyphSeed": {
          "minimum": 0,
          "type": "integer"
        },
        "glyphVersion": {
          "type": "string"
        },
        "manifestHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "svg": {},
        "svgHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "watermarkRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "bindingStatus",
        "glyphVersion",
        "glyphSeed",
        "geometry",
        "svg",
        "svgHash",
        "manifestHash",
        "watermarkRequired"
      ],
      "type": "object"
    },
    "identity": {
      "additionalProperties": true,
      "properties": {
        "canonicalName": {
          "minLength": 3,
          "type": "string"
        },
        "cohort": {
          "enum": [
            "GENESIS",
            "EVOLVED",
            "ASCENDED"
          ]
        },
        "epithet": {
          "type": "string"
        },
        "era": {
          "enum": [
            "PRIMORDIAL_ORIGIN",
            "EVOLVED_ORIGIN",
            "ASCENDED_ORIGIN"
          ]
        },
        "generationVersion": {
          "type": "string"
        },
        "seed": {
          "type": [
            "string",
            "integer"
          ]
        },
        "serial": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "LEGENDARY",
            "EPIC",
            "RARE"
          ]
        },
        "title": {
          "minLength": 3,
          "type": "string"
        },
        "tokenId": {
          "maximum": 6000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "tokenId",
        "serial",
        "canonicalName",
        "title",
        "tier",
        "cohort",
        "era",
        "generationVersion",
        "seed"
      ],
      "type": "object"
    },
    "lighting": {
      "additionalProperties": true,
      "required": [
        "keyLight",
        "rimLight",
        "accentLight",
        "contrastLevel",
        "shadowStyle"
      ],
      "type": "object"
    },
    "loreBinding": {
      "additionalProperties": false,
      "properties": {
        "bindingStatus": {
          "const": "CANONICAL_BOUND"
        },
        "loreVersion": {
          "const": "OX-GENESIS-LORE-1"
        },
        "packageHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "sourceAuthority": {
          "const": "OX-GENESIS-LORE-1"
        }
      },
      "required": [
        "bindingStatus",
        "loreVersion",
        "packageHash",
        "sourceAuthority"
      ],
      "type": "object"
    },
    "materials": {
      "additionalProperties": true,
      "required": [
        "primaryMaterial",
        "secondaryMaterial",
        "surfaceAge",
        "damageProfile"
      ],
      "type": "object"
    },
    "powers": {
      "additionalProperties": true,
      "required": [
        "signatureAbility",
        "energyMode",
        "powerExpression"
      ],
      "type": "object"
    },
    "qualityTarget": {
      "properties": {
        "minimumScore": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "mustPass": {
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "minimumScore",
        "mustPass"
      ],
      "type": "object"
    },
    "resonance": {
      "additionalProperties": false,
      "properties": {
        "bindingStatus": {
          "const": "CANONICAL_BOUND"
        },
        "glyphSeed": {
          "minimum": 0,
          "type": "integer"
        },
        "interpretation": {},
        "phaseDegrees": {
          "type": "integer"
        },
        "primaryFrequency": {
          "type": "integer"
        },
        "pulse": {
          "type": "integer"
        },
        "resonanceClass": {
          "type": "string"
        },
        "resonanceId": {
          "type": "string"
        },
        "resonanceSignature": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "resonanceVersion": {
          "type": "string"
        },
        "secondaryFrequency": {
          "type": "integer"
        },
        "spectrum": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "bindingStatus",
        "resonanceVersion",
        "resonanceId",
        "resonanceSignature",
        "resonanceClass",
        "spectrum",
        "primaryFrequency",
        "secondaryFrequency",
        "pulse",
        "phaseDegrees",
        "glyphSeed",
        "interpretation"
      ],
      "type": "object"
    }
  },
  "required": [
    "identity",
    "classification",
    "anatomy",
    "materials",
    "armorAndRelics",
    "powers",
    "resonance",
    "glyph",
    "environment",
    "composition",
    "lighting",
    "detailPolicy",
    "qualityTarget",
    "akashic"
  ],
  "title": "OriginX Dragon Identity v1",
  "type": "object"
}
