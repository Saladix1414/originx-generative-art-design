{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ox-canonical-output-manifest-1.schema.json",
  "title": "OriginX Generative Art Design Canonical Output Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "phase",
    "canonical_id",
    "candidate_id",
    "artifact",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "ox-canonical-output-manifest-1"
    },
    "project": {
      "const": "originx-generative-art-design"
    },
    "phase": {
      "const": "phase12"
    },
    "canonical_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_manifest_sha256",
        "promotion_decision",
        "ledger_index"
      ],
      "properties": {
        "provenance_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "promotion_decision": {
          "const": "promoted"
        },
        "ledger_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
