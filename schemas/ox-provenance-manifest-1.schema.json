{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ox-provenance-manifest-1.schema.json",
  "title": "OriginX Generative Art Design Provenance Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "phase",
    "created_at",
    "inputs",
    "model",
    "render",
    "output",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "ox-provenance-manifest-1"
    },
    "project": {
      "const": "originx-generative-art-design"
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["art_spec_id", "identity_input_id"],
      "properties": {
        "art_spec_id": { "type": "string", "minLength": 1 },
        "identity_input_id": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "binding_id"],
      "properties": {
        "registry_id": { "type": "string", "minLength": 1 },
        "binding_id": { "type": "string", "minLength": 1 }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "backend_id"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "backend_id": { "type": "string", "minLength": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256"],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
