{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:originx:ox-gad:schema:ox-art-spec-1",
  "title": "OriginX Structured Art Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "seed",
    "identity",
    "dragon",
    "environment",
    "camera",
    "pose",
    "framing",
    "composition",
    "lighting",
    "materials",
    "colorPolicy",
    "detail",
    "resonance",
    "renderIntent",
    "negativeConstraints",
    "qualityRequirements"
  ],
  "properties": {
    "specVersion": {
      "const": "OX-ART-SPEC-1"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "dragon": {
      "$ref": "#/$defs/dragon"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "camera": {
      "$ref": "#/$defs/camera"
    },
    "pose": {
      "$ref": "#/$defs/pose"
    },
    "framing": {
      "$ref": "#/$defs/framing"
    },
    "composition": {
      "$ref": "#/$defs/composition"
    },
    "lighting": {
      "$ref": "#/$defs/lighting"
    },
    "materials": {
      "$ref": "#/$defs/materials"
    },
    "colorPolicy": {
      "$ref": "#/$defs/colorPolicy"
    },
    "detail": {
      "$ref": "#/$defs/detailHierarchy"
    },
    "resonance": {
      "$ref": "#/$defs/resonance"
    },
    "renderIntent": {
      "$ref": "#/$defs/renderIntent"
    },
    "negativeConstraints": {
      "$ref": "#/$defs/negativeConstraints"
    },
    "qualityRequirements": {
      "$ref": "#/$defs/qualityRequirements"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "normalizedValue": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "hash256": {
      "type": "string",
      "pattern": "^(sha256:)?[a-f0-9]{64}$"
    },
    "featureBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form"
      ],
      "properties": {
        "form": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "traits": {
          "$ref": "#/$defs/stringList"
        },
        "materials": {
          "$ref": "#/$defs/stringList"
        },
        "palette": {
          "$ref": "#/$defs/stringList"
        },
        "condition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "symmetry": {
          "enum": [
            "BILATERAL",
            "ASYMMETRIC",
            "RADIAL",
            "NONE"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenId",
        "serial",
        "canonicalName",
        "tier",
        "era",
        "generationTheme",
        "dna",
        "dnaHash"
      ],
      "properties": {
        "tokenId": {
          "type": "integer",
          "minimum": 1
        },
        "serial": {
          "type": "string",
          "pattern": "^#[0-9]{4,6}$"
        },
        "canonicalName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tier": {
          "enum": [
            "RARE",
            "EPIC",
            "LEGENDARY"
          ]
        },
        "era": {
          "enum": [
            "Primitive Origin",
            "Evolved Origin",
            "Ascended Origin"
          ]
        },
        "generationTheme": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dna": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "dnaHash": {
          "$ref": "#/$defs/hash256"
        }
      }
    },
    "dragon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype",
        "bodyStructure",
        "head",
        "horns",
        "eyes",
        "body",
        "scales",
        "wings",
        "tail",
        "armor",
        "mechanicalAugmentation",
        "markings"
      ],
      "properties": {
        "archetype": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "bodyStructure": {
          "$ref": "#/$defs/featureBlock"
        },
        "head": {
          "$ref": "#/$defs/featureBlock"
        },
        "horns": {
          "$ref": "#/$defs/featureBlock"
        },
        "eyes": {
          "$ref": "#/$defs/featureBlock"
        },
        "body": {
          "$ref": "#/$defs/featureBlock"
        },
        "scales": {
          "$ref": "#/$defs/featureBlock"
        },
        "wings": {
          "$ref": "#/$defs/featureBlock"
        },
        "tail": {
          "$ref": "#/$defs/featureBlock"
        },
        "armor": {
          "$ref": "#/$defs/featureBlock"
        },
        "mechanicalAugmentation": {
          "$ref": "#/$defs/featureBlock"
        },
        "markings": {
          "$ref": "#/$defs/featureBlock"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biome",
        "terrain",
        "architecture",
        "atmosphere",
        "weather",
        "depthLayers"
      ],
      "properties": {
        "biome": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "terrain": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/featureBlock"
        },
        "atmosphere": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "weather": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "depthLayers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "foreground",
            "midground",
            "background"
          ],
          "properties": {
            "foreground": {
              "$ref": "#/$defs/stringList"
            },
            "midground": {
              "$ref": "#/$defs/stringList"
            },
            "background": {
              "$ref": "#/$defs/stringList"
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "lensMm",
        "height",
        "pitchDegrees",
        "yawDegrees",
        "rollDegrees",
        "focalTarget",
        "distance"
      ],
      "properties": {
        "projection": {
          "enum": [
            "PERSPECTIVE",
            "ORTHOGRAPHIC"
          ]
        },
        "lensMm": {
          "type": "number",
          "minimum": 8,
          "maximum": 300
        },
        "height": {
          "enum": [
            "GROUND",
            "LOW",
            "EYE",
            "HIGH",
            "AERIAL"
          ]
        },
        "pitchDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "yawDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "rollDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "focalTarget": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "distance": {
          "enum": [
            "EXTREME_CLOSE",
            "CLOSE",
            "MEDIUM",
            "WIDE",
            "EXTREME_WIDE"
          ]
        }
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stance",
        "motionState",
        "headDirection",
        "wingState",
        "tailFlow",
        "contactPoints"
      ],
      "properties": {
        "stance": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "motionState": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "headDirection": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "wingState": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tailFlow": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contactPoints": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "subjectOccupancy",
        "cropPolicy",
        "safeMargin"
      ],
      "properties": {
        "aspectRatio": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "subjectOccupancy": {
          "$ref": "#/$defs/normalizedValue"
        },
        "cropPolicy": {
          "enum": [
            "FULL_BODY_REQUIRED",
            "FULL_SUBJECT_PREFERRED",
            "CONTROLLED_CROP",
            "PORTRAIT_CROP"
          ]
        },
        "safeMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dominance",
        "balance",
        "symmetry",
        "ruleOfThirds",
        "environmentRatio",
        "depthPriority",
        "leadingGeometry"
      ],
      "properties": {
        "dominance": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "balance": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "symmetry": {
          "enum": [
            "SYMMETRIC",
            "ASYMMETRIC",
            "NEAR_SYMMETRIC"
          ]
        },
        "ruleOfThirds": {
          "type": "boolean"
        },
        "environmentRatio": {
          "$ref": "#/$defs/normalizedValue"
        },
        "depthPriority": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "leadingGeometry": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "fill",
        "rim",
        "volumetrics",
        "contrast",
        "exposureBias"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fill": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rim": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "volumetrics": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contrast": {
          "$ref": "#/$defs/normalizedValue"
        },
        "exposureBias": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libraryRefs",
        "assignments",
        "weatheringPolicy"
      ],
      "properties": {
        "libraryRefs": {
          "$ref": "#/$defs/stringList"
        },
        "assignments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "weatheringPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "colorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basePalette",
        "accentPalette",
        "energyPalette",
        "neonLimit",
        "saturationPolicy"
      ],
      "properties": {
        "basePalette": {
          "$ref": "#/$defs/stringList"
        },
        "accentPalette": {
          "$ref": "#/$defs/stringList"
        },
        "energyPalette": {
          "$ref": "#/$defs/stringList"
        },
        "neonLimit": {
          "$ref": "#/$defs/normalizedValue"
        },
        "saturationPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "detailLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "targets",
        "constraints"
      ],
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "targets": {
          "$ref": "#/$defs/stringList"
        },
        "constraints": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "detailHierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro",
        "meso",
        "micro"
      ],
      "properties": {
        "macro": {
          "$ref": "#/$defs/detailLayer"
        },
        "meso": {
          "$ref": "#/$defs/detailLayer"
        },
        "micro": {
          "$ref": "#/$defs/detailLayer"
        }
      }
    },
    "resonance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrativeOnly",
        "strength",
        "spectrum",
        "energyTopology",
        "accentGeometry",
        "lightingRhythm",
        "glyphInfluence",
        "atmosphericBehavior"
      ],
      "properties": {
        "narrativeOnly": {
          "const": true
        },
        "strength": {
          "$ref": "#/$defs/normalizedValue"
        },
        "spectrum": {
          "$ref": "#/$defs/stringList"
        },
        "energyTopology": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "accentGeometry": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "lightingRhythm": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "glyphInfluence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "atmosphericBehavior": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "renderIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "styleIntent",
        "realism",
        "cinematicWeight",
        "detailDensity",
        "targetAspectRatio",
        "targetResolution",
        "preserveIdentity"
      ],
      "properties": {
        "styleIntent": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "realism": {
          "$ref": "#/$defs/normalizedValue"
        },
        "cinematicWeight": {
          "$ref": "#/$defs/normalizedValue"
        },
        "detailDensity": {
          "$ref": "#/$defs/normalizedValue"
        },
        "targetAspectRatio": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "targetResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 64
            },
            "height": {
              "type": "integer",
              "minimum": 64
            }
          }
        },
        "preserveIdentity": {
          "const": true
        }
      }
    },
    "negativeConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forbiddenElements",
        "allowFranchiseImitation",
        "allowWatermark",
        "allowUncontrolledText",
        "allowCartoonStyling",
        "allowDetailToMaskBadAnatomy"
      ],
      "properties": {
        "forbiddenElements": {
          "$ref": "#/$defs/stringList"
        },
        "allowFranchiseImitation": {
          "const": false
        },
        "allowWatermark": {
          "const": false
        },
        "allowUncontrolledText": {
          "const": false
        },
        "allowCartoonStyling": {
          "const": false
        },
        "allowDetailToMaskBadAnatomy": {
          "const": false
        }
      }
    },
    "qualityRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumScores",
        "maximumArtifactScore",
        "requireManualApproval",
        "canonicalApprovalMode"
      ],
      "properties": {
        "minimumScores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anatomy",
            "silhouette",
            "composition",
            "traitCompliance",
            "material",
            "detail",
            "identityConsistency",
            "visualGrammar"
          ],
          "properties": {
            "anatomy": {
              "$ref": "#/$defs/normalizedValue"
            },
            "silhouette": {
              "$ref": "#/$defs/normalizedValue"
            },
            "composition": {
              "$ref": "#/$defs/normalizedValue"
            },
            "traitCompliance": {
              "$ref": "#/$defs/normalizedValue"
            },
            "material": {
              "$ref": "#/$defs/normalizedValue"
            },
            "detail": {
              "$ref": "#/$defs/normalizedValue"
            },
            "identityConsistency": {
              "$ref": "#/$defs/normalizedValue"
            },
            "visualGrammar": {
              "$ref": "#/$defs/normalizedValue"
            }
          }
        },
        "maximumArtifactScore": {
          "$ref": "#/$defs/normalizedValue"
        },
        "requireManualApproval": {
          "const": true
        },
        "canonicalApprovalMode": {
          "const": "MANUAL_REQUIRED"
        }
      }
    }
  }
}
