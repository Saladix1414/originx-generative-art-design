{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ox-master-prompt-catalog-1.schema.json",
  "title": "OriginX Master Prompt Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "positive_language",
    "negative_language",
    "camera_language",
    "lighting_language",
    "material_language",
    "detail_language",
    "safety_language"
  ],
  "properties": {
    "schema_version": {
      "const": "ox-master-prompt-catalog-1"
    },
    "project": {
      "const": "originx-generative-art-design"
    },
    "positive_language": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negative_language": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "camera_language": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lighting_language": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "material_language": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "detail_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro",
        "meso",
        "micro"
      ],
      "properties": {
        "macro": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "meso": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "micro": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "safety_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forbidden_terms",
        "required_negative_terms"
      ],
      "properties": {
        "forbidden_terms": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_negative_terms": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
